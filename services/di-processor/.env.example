APP_CONFIGURATION_ENDPOINT=
SERVICE_BUS_NAMESPACE_FQDN=
POSTGRES_HOST=

# Blob storage account (https://<account>.blob.core.windows.net)
BLOB_ACCOUNT_URL=

# Queue names (defaults shown; override if the provisioned names differ)
RAW_DMER_QUEUE=raw-dmer-queue
EXTRACTED_DMER_QUEUE=extracted-dmer-queue

# Blob container names (defaults shown; override if the provisioned names differ)
EXTRACTED_DMER_CONTAINER=extracted-dmer
COMBINED_EXTRACTED_DMER_CONTAINER=combined-extracted-dmer

# Document Intelligence (Managed Identity over private endpoint)
DOC_INTELLIGENCE_ENDPOINT=
DI_CUSTOM_MODEL_ID=

# LLM reconstruction prompt version tag (optional; recorded in combined metadata)
LLM_PROMPT_VERSION=

# External Azure OpenAI (Key Vault API key — the one documented MI exception)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Health server port (readiness/liveness probes)
HEALTH_PORT=8080
