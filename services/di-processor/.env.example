APP_CONFIGURATION_ENDPOINT=
SERVICE_BUS_NAMESPACE_FQDN=
POSTGRES_HOST=
POSTGRES_DATABASE=dmer
# Role to log in as. Deployed: the di-processor Managed Identity's name
# (e.g. id-rsbc-dmer-di-processor-dev-001), authenticated with an Entra token.
POSTGRES_USER=
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require
# Local development only; leave unset to authenticate with an Entra token.
# POSTGRES_PASSWORD=

# Blob storage account (https://<account>.blob.core.windows.net)
BLOB_ACCOUNT_URL=

# Queue names (defaults shown; override if the provisioned names differ)
DMER_RAW_QUEUE=dmer-raw
DMER_EXTRACTED_QUEUE=dmer-extracted

# Blob container name (default shown; override if the provisioned name differs).
# All four extraction artifacts live under this one container, namespaced by
# document id: extracted-dmer/<documentId>/{top_level,ocr,handwritten,combined}.json
EXTRACTED_DMER_CONTAINER=extracted-dmer

# Document Intelligence (Managed Identity over private endpoint)
DOC_INTELLIGENCE_ENDPOINT=
DI_CUSTOM_MODEL_ID=

# LLM reconstruction prompt version tag (optional; recorded in combined metadata)
LLM_PROMPT_VERSION=

# External Azure OpenAI (Key Vault API key — the one documented MI exception)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Health server port (readiness/liveness probes)
HEALTH_PORT=8080
